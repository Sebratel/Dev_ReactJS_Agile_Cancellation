    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction clean(value, fallback = '-') {\n  if (value === null || value === undefined) return fallback;\n  const text = String(value).replace(/\\s+/g, ' ').trim();\n  return text === '' ? fallback : text;\n}\n\nfunction onlyDigits(value) {\n  if (!value) return '';\n  return String(value).replace(/\\D/g, '');\n}\n\nfunction normalizePhoneBR(value) {\n  let digits = onlyDigits(value);\n\n  if (!digits) {\n    return { original: '-', phoneFormatted: '', isValid: false };\n  }\n\n  if (digits.startsWith('55') && digits.length > 11) {\n    digits = digits.slice(2);\n  }\n\n  while (digits.startsWith('0') && digits.length > 11) {\n    digits = digits.slice(1);\n  }\n\n  if (digits.length === 10) {\n    const ddd = digits.slice(0, 2);\n    const numero = digits.slice(2);\n\n    if (/^[6-9]/.test(numero)) {\n      digits = ddd + '9' + numero;\n    }\n  }\n\n  const isValidMobile = /^[1-9]{2}9\\d{8}$/.test(digits);\n  const isValidLandline = /^[1-9]{2}[2-5]\\d{7}$/.test(digits);\n\n  if (isValidMobile || isValidLandline) {\n    return {\n      original: clean(value),\n      phoneFormatted: `55${digits}`,\n      isValid: true\n    };\n  }\n\n  return { original: clean(value), phoneFormatted: '', isValid: false };\n}\n\nfunction firstName(name) {\n  const value = clean(name, 'cliente');\n  return value.split(' ')[0] || 'cliente';\n}\n\nreturn items.map((item) => {\n  const body = item.json.body ?? item.json;\n  const phone = normalizePhoneBR(body.telefone ?? body.telefoneContato ?? body.phone);\n  const cliente = clean(body.cliente ?? body.customerName);\n  const contrato = clean(body.contrato ?? body.contractCode);\n\n  return {\n    json: {\n      caseId: clean(body.caseId, ''),\n      cliente,\n      nomeCurtoCliente: clean(body.nomeCurtoCliente, firstName(cliente)),\n      contrato,\n      telefoneContato: phone.original,\n      phone_formatted: phone.phoneFormatted,\n      telefoneValido: phone.isValid\n    }\n  };\n});"
      },
