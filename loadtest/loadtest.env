# Variaveis do teste de carga. Valores PLACEHOLDER, validos so neste ambiente descartavel.
# Perfil medium (deploy/profiles/medium.env)
BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=1.0
BACKEND_HEAP_MB=768
MARIADB_MEM_LIMIT=1g
MARIADB_CPUS=1.0
MARIADB_BUFFER_POOL=512M
MARIADB_MAX_CONNECTIONS=100
FRONTEND_MEM_LIMIT=128m
FRONTEND_CPUS=0.5

# Banco da aplicacao (MariaDB da stack)
MARIADB_ROOT_PASSWORD=loadtest-root-not-a-secret
MARIADB_USER=ger
MARIADB_PASSWORD=loadtest-db-not-a-secret

# API em producao (NODE_ENV=production exige segredos fortes e CORS fora de localhost)
NODE_ENV=production
JWT_SECRET=loadtest-jwt-9f8e7d6c5b4a39281706f5e4d3c2b1a0
N8N_WEBHOOK_SECRET=loadtest-webhook-0123456789abcdef
GOOGLE_AUTH_MODE=mock
CORS_ORIGIN=https://ger-loadtest.example.com
ALLOW_DATABASE_UNAVAILABLE=false
API_PORT=4000
WEB_PORT=8081

# ERP artificial (Postgres 16 do compose do loadtest)
ERP_SYNC_ENABLED=true
# o backend fala com o ERP atraves do proxy de latencia
ERP_DB_HOST=erp-latency
ERP_DB_PORT=5432
ERP_DB_NAME=erp_artificial
ERP_DB_USER=erp_user
ERP_DB_PASSWORD=erp-test-placeholder-not-a-secret
ERP_DB_SSL=false

# Webhooks N8N apontando para o mock local (sem rede externa)
N8N_MATRIX_HSM_WEBHOOK_URL=http://n8n-mock:8080/webhook/hsm
N8N_MATRIX_HSM_WEBHOOK_SECRET=loadtest-hsm-secret-placeholder
N8N_RECOVERY_WEBHOOK_URL=http://n8n-mock:8080/webhook/recovery
N8N_RECOVERY_WEBHOOK_SECRET=loadtest-recovery-secret-placeholder

# Dataset e latencia do ERP artificial (ver loadtest/README.md)
ERP_SCALE=1
ERP_ELIG_PCT=3
ERP_MEM_LIMIT=6g
ERP_LAT_FAST_MS=3.6
ERP_LAT_FAST_SD=1.2
ERP_LAT_SLOW_MS=29
ERP_LAT_SLOW_SD=3
ERP_LAT_SLOW_PROB=0.23
ERP_LAT_CONNECT_EXTRA_MS=36
ERP_LAT_CONNECT_SIGMA=0.2

# Cliente virtual: RTT de rede e tempo de "leitura da tela" (ms)
CLIENT_RTT_MS=20
CLIENT_RTT_JITTER_MS=10
THINK_MIN_MS=1000
THINK_MAX_MS=5000
