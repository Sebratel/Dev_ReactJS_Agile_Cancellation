{
  "name": "ger-collection-cancellation-api",
  "private": true,
  "version": "0.1.0",
  "description": "Backend foundation for GER - Gestao de Cobranca e Cancelamento",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "jest --watch",
    "test:run": "jest --runInBand --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "node ./scripts/security-scan.mjs",
    "prisma:validate": "node ./scripts/prisma-validate.mjs",
    "prisma:format": "node ./scripts/prisma-format.mjs",
    "prisma:generate": "node ./scripts/prisma-generate.mjs",
    "prisma:migrate:dev": "node ./scripts/prisma-migrate-dev.mjs",
    "prisma:migrate:status": "node ./scripts/prisma-migrate-status.mjs",
    "prisma:migrate:deploy": "node ./scripts/prisma-migrate-deploy.mjs",
    "prisma:seed": "node ./scripts/prisma-seed.mjs",
    "db:setup": "node ./scripts/db-setup.mjs",
    "db:backfill-initial-attempts": "node ./scripts/backfill-initial-attempts.mjs",
    "db:reset-demo": "node ./scripts/db-reset-demo.mjs",
    "db:reset-demo:confirm": "node ./scripts/db-reset-demo.mjs --confirm",
    "erp-sync:run-once": "node ./scripts/erp-sync-run-once.mjs",
    "test:db": "node ./scripts/run-test-db.mjs"
  },
  "prisma": {
    "seed": "node ./scripts/prisma-seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.15.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
