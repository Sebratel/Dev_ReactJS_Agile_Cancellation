datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING_ACTIVATION
}

enum ContractStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  WRITTEN_OFF
}

enum CollectionStatus {
  WAITING_TRIAGE
  IN_COLLECTION
  AWAITING_PAYMENT
  NO_RESPONSE
  ELIGIBLE_FOR_CANCELLATION
  CANCELLATION_IN_PROGRESS
  CLOSED
  RECOVERED
  PAYMENT_MADE
  RENEGOTIATED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AttemptChannel {
  PHONE
  EMAIL
  SMS
  WHATSAPP
  LETTER
  IN_PERSON
  OTHER
}

enum AttemptResult {
  CONTACTED
  NO_ANSWER
  VOICEMAIL
  PROMISE_MADE
  REFUSED
  WRONG_NUMBER
  CALLBACK_REQUESTED
  OTHER
}

enum PaymentPromiseStatus {
  ACTIVE
  FULFILLED
  BROKEN
  CANCELLED
  EXPIRED
}

enum CancellationStatus {
  PENDING
  IN_PROGRESS
  AWAITING_PROTOCOL
  AWAITING_PICKUP
  COMPLETED
  CANCELLED
  FAILED
}

enum CancellationStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  INTEGRATION
}

enum IntegrationEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  DISCARDED
}

enum BulkContactJobStatus {
  PENDING
  PROCESSING
  COMPLETED
}

enum BulkContactItemStatus {
  PENDING
  SENT
  SKIPPED_STATUS
  SKIPPED_PHONE
  FAILED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String
  status           UserStatus @default(ACTIVE)
  avatarUrl        String?
  lastLoginAt      DateTime?
  refreshTokenHash String?
  externalId       String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  userRoles               UserRole[]
  assignedCollectionCases CollectionCase[]    @relation("CollectionCaseAssignee")
  collectionAttempts      CollectionAttempt[] @relation("CollectionAttemptPerformer")
  auditLogs               AuditLog[]
  caseNotes               CaseNote[]          @relation("CaseNoteAuthor")
  notifications           Notification[]

  @@index([status])
  @@index([name])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  externalId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles UserRole[]

  @@index([name])
  @@map("roles")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  document   String   @unique
  email      String?
  phone      String?
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contracts             Contract[]
  collectionCases       CollectionCase[]
  cancellationProcesses CancellationProcess[]

  @@index([name])
  @@index([email])
  @@map("customers")
}

model Contract {
  id           String         @id @default(cuid())
  customerId   String
  code         String         @unique
  status       ContractStatus @default(ACTIVE)
  // Status BRUTO do ERP (v_status do Elleven) para exibicao fiel — ex.:
  // "Normal", "Suspenso", "Bloqueio Financeiro", "Cancelado". O enum `status`
  // acima (mapeado) continua para a logica interna.
  erpStatus    String?
  startDate    DateTime
  endDate      DateTime?
  totalValue   Decimal?       @db.Decimal(15, 2)
  monthlyValue Decimal?       @db.Decimal(15, 2)
  externalId   String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoices              Invoice[]
  collectionCases       CollectionCase[]
  cancellationProcesses CancellationProcess[]

  @@index([customerId])
  @@index([status])
  @@index([startDate])
  @@map("contracts")
}

model Invoice {
  id            String        @id @default(cuid())
  contractId    String
  invoiceNumber String?
  status        InvoiceStatus @default(OPEN)
  dueDate       DateTime
  amount        Decimal       @db.Decimal(15, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(15, 2)
  externalId    String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model CollectionCase {
  id                   String           @id @default(cuid())
  contractId           String
  customerId           String
  assignedUserId       String?
  status               CollectionStatus @default(WAITING_TRIAGE)
  priority             Priority         @default(MEDIUM)
  outstandingAmount    Decimal          @db.Decimal(15, 2)
  daysOverdue          Int              @default(0)
  externalId           String?          @unique
  slaDueAt             DateTime?
  recoveredAt          DateTime?
  // Inicio do ciclo de cobranca atual. Setado na criacao e a cada reabertura
  // (contrato finalizado que volta a ficar elegivel). Usado para classificar
  // Recuperado x Pagamento realizado olhando so as tentativas do ciclo atual.
  cycleStartedAt       DateTime?
  matrixAttendanceCode String?          @unique
  matrixMessageCode    String?          @unique
  matrixAwaitingReply  Boolean          @default(false)
  matrixLastOutboundAt DateTime?
  matrixLastReplyAt    DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  contract              Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser          User?                 @relation("CollectionCaseAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  collectionAttempts    CollectionAttempt[]
  paymentPromises       PaymentPromise[]
  cancellationProcesses CancellationProcess[]
  caseNotes             CaseNote[]

  @@index([contractId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([status])
  @@index([priority])
  @@index([daysOverdue])
  @@index([slaDueAt])
  @@index([recoveredAt])
  @@index([matrixAwaitingReply])
  @@index([matrixLastOutboundAt])
  @@index([matrixLastReplyAt])
  @@map("collection_cases")
}

model CollectionAttempt {
  id                String         @id @default(cuid())
  collectionCaseId  String
  performedByUserId String?
  channel           AttemptChannel
  result            AttemptResult
  attemptedAt       DateTime
  nextContactAt     DateTime?
  notes             String?        @db.Text
  externalId        String?        @unique
  isAutomatic       Boolean        @default(false)
  createdAt         DateTime       @default(now())

  collectionCase CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)
  performedBy    User?          @relation("CollectionAttemptPerformer", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([collectionCaseId])
  @@index([performedByUserId])
  @@index([attemptedAt])
  @@index([nextContactAt])
  @@index([channel])
  @@index([result])
  @@map("collection_attempts")
}

model CaseNote {
  id               String   @id @default(cuid())
  collectionCaseId String
  authorId         String?
  content          String   @db.Text
  createdAt        DateTime @default(now())

  collectionCase CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)
  author         User?          @relation("CaseNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([collectionCaseId])
  @@index([authorId])
  @@index([createdAt])
  @@map("case_notes")
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model PaymentPromise {
  id               String               @id @default(cuid())
  collectionCaseId String
  status           PaymentPromiseStatus @default(ACTIVE)
  promisedAmount   Decimal              @db.Decimal(15, 2)
  promisedDate     DateTime
  notes            String?              @db.Text
  fulfilledAt      DateTime?
  brokenAt         DateTime?
  cancelledAt      DateTime?
  externalId       String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  collectionCase CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)

  @@index([collectionCaseId])
  @@index([status])
  @@index([promisedDate])
  @@map("payment_promises")
}

model CancellationProcess {
  id               String             @id @default(cuid())
  collectionCaseId String?
  contractId       String
  customerId       String
  status           CancellationStatus @default(PENDING)
  externalId       String?            @unique
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  collectionCase CollectionCase?    @relation(fields: [collectionCaseId], references: [id], onDelete: SetNull)
  contract       Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  steps          CancellationStep[]

  @@index([collectionCaseId])
  @@index([contractId])
  @@index([customerId])
  @@index([status])
  @@map("cancellation_processes")
}

model CancellationStep {
  id                    String                 @id @default(cuid())
  cancellationProcessId String
  name                  String
  stepOrder             Int
  status                CancellationStepStatus @default(PENDING)
  completedAt           DateTime?
  metadata              Json?
  externalId            String?                @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  cancellationProcess CancellationProcess @relation(fields: [cancellationProcessId], references: [id], onDelete: Cascade)

  @@index([cancellationProcessId])
  @@index([status])
  @@index([stepOrder])
  @@map("cancellation_steps")
}

model AuditLog {
  id                String      @id @default(cuid())
  entityType        String
  entityId          String
  action            AuditAction
  performedByUserId String?
  beforeSnapshot    Json?
  afterSnapshot     Json?
  metadata          Json?
  createdAt         DateTime    @default(now())

  performedBy User? @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([performedByUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model IntegrationEvent {
  id           String                 @id @default(cuid())
  source       String
  eventType    String
  externalId   String?                @unique
  status       IntegrationEventStatus @default(PENDING)
  payload      Json?
  errorMessage String?                @db.Text
  processedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([source])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("integration_events")
}

// Envio de HSM em lote: a requisicao so cria o job (rapido) e um worker
// (WhatsappBulkContactWorkerService, via @nestjs/schedule) processa os itens
// aos poucos em segundo plano — cada envio chama o mesmo webhook do n8n do
// envio individual (ate 15s cada), entao centenas de itens nao cabem numa
// unica requisicao HTTP sincrona. Sem fila dedicada (Redis/BullMQ) por
// escolha do time — o proprio MariaDB atua como fila simples.
model BulkContactJob {
  id              String                @id @default(cuid())
  status          BulkContactJobStatus  @default(PENDING)
  totalCount      Int
  sentCount       Int                   @default(0)
  skippedCount    Int                   @default(0)
  failedCount     Int                   @default(0)
  createdByUserId String?
  createdAt       DateTime              @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  items BulkContactJobItem[]

  @@index([status])
  @@index([createdAt])
  @@map("bulk_contact_jobs")
}

model BulkContactJobItem {
  id               String                 @id @default(cuid())
  jobId            String
  collectionCaseId String
  status           BulkContactItemStatus  @default(PENDING)
  errorMessage     String?                @db.Text
  processedAt      DateTime?
  createdAt        DateTime               @default(now())

  job BulkContactJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, collectionCaseId])
  @@index([jobId, status])
  @@map("bulk_contact_job_items")
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String    @db.Text
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}
