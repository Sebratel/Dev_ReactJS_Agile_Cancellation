APP_NAME="ger-collection-cancellation-api"
PORT=4000
NODE_ENV="development"

# Origem permitida pelo CORS (em producao, nunca use localhost)
CORS_ORIGIN="http://localhost:5173"

# Conexao MySQL/MariaDB
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_Cancellation_Plataform?connection_limit=5"

APP_TIMEZONE="UTC"
PRISMA_AUTO_CONNECT="true"

# "mock" usa dados em memoria | "database" usa MySQL via Prisma
DATA_SOURCE_MODE="mock"

# JWT — obrigatorio em producao, minimo 32 chars, sem placeholders
JWT_SECRET="change-me-in-local-env"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Senhas dos usuarios de seed (usadas apenas em dev/homolog)
DEV_ADMIN_PASSWORD=""
DEV_FINANCE_PASSWORD=""
MOCK_AUTH_DEV_PASSWORD=""

# Integracao Eleven: stub | disabled | live
ELEVEN_MODE="stub"

# Segredo compartilhado para autenticar webhooks do N8N (header X-Webhook-Secret)
# Obrigatorio em producao (minimo 16 caracteres)
N8N_WEBHOOK_SECRET=""
