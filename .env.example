VITE_APP_NAME="GER - Gestao de Cobranca e Cancelamento"
VITE_API_BASE_URL="http://localhost:4000"

# Client ID do Google OAuth no frontend.
# Obrigatorio para renderizar o botao real "Entrar com Google".
VITE_GOOGLE_CLIENT_ID=""

APP_NAME="ger-collection-cancellation-api"
PORT=4000
NODE_ENV="staging"
CORS_ORIGIN="http://localhost:5173"
APP_TIMEZONE="UTC"

# Docker/Portainer MariaDB
MARIADB_ROOT_PASSWORD=""
MARIADB_USER=""
MARIADB_PASSWORD=""
API_PORT=4000
WEB_PORT=80

# Conexao MySQL/MariaDB usada pela API.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_Cancellation_Plataform?connection_limit=5"
PRISMA_AUTO_CONNECT="true"
ALLOW_DATABASE_UNAVAILABLE="true"
DATA_SOURCE_MODE="database"

# JWT - obrigatorio em producao, minimo 32 caracteres.
JWT_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Usuarios de seed/desenvolvimento.
DEV_ADMIN_PASSWORD=""
DEV_FINANCE_PASSWORD=""
MOCK_AUTH_DEV_PASSWORD=""

# Google OAuth validado no backend.
GOOGLE_CLIENT_ID=""
GOOGLE_AUTH_MODE="real"
GOOGLE_WORKSPACE_DOMAIN="sebratel.com.br"

# Integracao Eleven: stub | disabled | live
ELEVEN_MODE="stub"

# Webhooks N8N recebidos pela plataforma.
N8N_WEBHOOK_SECRET=""

# Webhook N8N que dispara HSM Matrix.
N8N_MATRIX_HSM_WEBHOOK_URL=""
N8N_MATRIX_HSM_WEBHOOK_SECRET=""
N8N_MATRIX_HSM_TIMEOUT_MS="15000"

# Sincronizacao ERP/Voalle.
ERP_SYNC_ENABLED="false"
ERP_DB_HOST=""
ERP_DB_PORT="5432"
ERP_DB_NAME=""
ERP_DB_USER=""
ERP_DB_PASSWORD=""
ERP_DB_SSL="false"
